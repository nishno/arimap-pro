rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // 
    // Collection: users
    // Fields: id, name, email, roles, status, isGuest, createdAt, currentOrgId
    //
    // Collection: organizations
    // Fields: id, name, type, location, isDiscoverable, creatorId, createdBy
    //
    // Collection: memberships
    // Fields: id, userId, organizationId, role
    //
    // Collection: plantationFeatures
    // Fields: id, name, type, layerId, organizationId
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/platformAccess/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/platformAccess/$(request.auth.uid)).data.get('accountDisabled', false) == false);
    }

    function isVerified() {
      return isAuthenticated();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Only a trusted server may set Firebase custom claims.
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.get('admin', false) == true || request.auth.token.get('platformOwner', false) == true) &&
        (!exists(/databases/$(database)/documents/platformAccess/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/platformAccess/$(request.auth.uid)).data.get('disabled', false) == false);
    }

    function isPlatformOwner() {
      return isAdmin() && request.auth.token.get('platformOwner', false) == true;
    }
    function protectedPlatformUser(userId) {
      return exists(/databases/$(database)/documents/platformAccess/$(userId)) &&
        (get(/databases/$(database)/documents/platformAccess/$(userId)).data.get('owner', false) == true ||
         get(/databases/$(database)/documents/platformAccess/$(userId)).data.get('admin', false) == true);
    }

    function isMemberOf(orgId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)) ||
        existsAfter(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) && 
         (get(/databases/$(database)/documents/organizations/$(orgId)).data.get('creatorId', '') == request.auth.uid || 
          get(/databases/$(database)/documents/organizations/$(orgId)).data.get('createdBy', '') == request.auth.uid)) ||
        (existsAfter(/databases/$(database)/documents/organizations/$(orgId)) && 
         (getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.get('creatorId', '') == request.auth.uid || 
          getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.get('createdBy', '') == request.auth.uid)) ||
        isAdmin()
      );
    }

    function isOrgAdmin(orgId) {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)) && 
         get(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + orgId)).data.role in ['Founder', 'Admin', 'founder', 'admin', 'Founder/CEO', 'Co-Founder']) ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) && 
         (get(/databases/$(database)/documents/organizations/$(orgId)).data.get('creatorId', '') == request.auth.uid || 
          get(/databases/$(database)/documents/organizations/$(orgId)).data.get('createdBy', '') == request.auth.uid)) ||
        (existsAfter(/databases/$(database)/documents/organizations/$(orgId)) && 
         (getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.get('creatorId', '') == request.auth.uid || 
          getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.get('createdBy', '') == request.auth.uid))
      );
    }

    // Validation Helpers
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidEmail(email) {
      return email is string && email.size() > 5;
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function fieldUnchanged(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    // Domain Validators
    function isValidUser(data) {
      return true;
    }

    function isValidOrg(data) {
      return true;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /test/connection {
      allow get: if true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.get('id', userId) == userId &&
        request.resource.data.get('roles', []).hasOnly(['Guest', 'worker', 'User']) &&
        !request.resource.data.keys().hasAny(['password', 'newPassword', 'confirmPassword']) &&
        request.resource.data.get('tier', 'Free') == 'Free' &&
        request.resource.data.get('isPaid', false) == false &&
        request.resource.data.get('subscriptionType', 'Free') == 'Free' &&
        request.resource.data.get('subscriptionStatus', 'Unpaid') == 'Unpaid' &&
        request.resource.data.get('trialExpiry', '') == '' && request.resource.data.get('trial_start_date', '') == '' &&
        !request.resource.data.keys().hasAny(['subscriptionExpiry','subscriptionPlan','grantSource','grantedBy','grantedAt']);
      allow update: if !request.resource.data.keys().hasAny(['password', 'newPassword', 'confirmPassword']) &&
        (isAdmin() && (!protectedPlatformUser(userId) || isPlatformOwner()) || (isOwner(userId) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'id', 'roles', 'email', 'verificationStatus', 'kycStatus', 'status',
           'subscriptionType', 'subscriptionStatus', 'subscriptionExpiry', 'isPaid',
           'tier','subscriptionPlan','price','discount','trialExpiry','trial_start_date','grantSource','grantedBy','grantedAt'
         ])));
      allow delete: if isAdmin() && !protectedPlatformUser(userId);
    }

    match /organizations/{orgId} {
      allow list: if resource.data.get('isDiscoverable', false) == true || isAuthenticated();
      allow get: if isMemberOf(orgId) || isAdmin() || resource.data.get('isDiscoverable', false) == true;
      allow create: if isAdmin() || (isVerified() &&
                    (request.resource.data.get('creatorId', '') == request.auth.uid || request.resource.data.get('createdBy', '') == request.auth.uid) &&
                    isValidOrg(request.resource.data) &&
                    request.resource.data.get('tier', 'Free') == 'Free' &&
                    request.resource.data.get('isPaid', false) == false &&
                    request.resource.data.get('subscriptionStatus', 'Unpaid') == 'Unpaid' &&
                    request.resource.data.get('trialExpiry', '') == '' &&
                    request.resource.data.get('trial_start_date', '') == '' &&
                    request.resource.data.get('price', 0) == 0 && request.resource.data.get('discount', 0) == 0 &&
                    !request.resource.data.keys().hasAny(['subscriptionPlan','subscriptionType','subscriptionExpiry','trialStartedAt','grantSource','grantedBy','grantedAt']));
      allow update: if isAdmin() || (isVerified() && isOrgAdmin(orgId) && isValidOrg(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier','subscriptionPlan','subscriptionStatus','subscriptionType','subscriptionExpiry','isPaid','price','discount','trialExpiry','trial_start_date','trialStartedAt','grantSource','grantedBy','grantedAt']));
      allow delete: if isAdmin();
    }

    match /memberships/{membershipId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isOrgAdmin(resource.data.organizationId));
      allow create: if isAuthenticated() &&
        membershipId == request.resource.data.userId + '_' + request.resource.data.organizationId &&
        request.resource.data.role in ['Founder', 'Admin', 'Manager', 'Employee', 'worker', 'Agronomist', 'Accountant', 'Guest'] &&
        (isAdmin() || isOrgAdmin(request.resource.data.organizationId));
      allow update: if isOrgAdmin(resource.data.organizationId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.role in ['Founder', 'Admin', 'Manager', 'Employee', 'worker', 'Agronomist', 'Accountant', 'Guest'];
      allow delete: if isOrgAdmin(resource.data.organizationId) ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /projects/{projectId} {
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isMemberOf(resource.data.organizationId) || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Never use a wildcard rule for user profiles or memberships: Firestore
    // combines all matching allow rules with OR, not with AND.

    // Explicitly handle collections that were in the previous rules to ensure no regression
    match /plantationFeatures/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }
    
    match /layers/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /inventoryItems/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /harvestEvents/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /accounts/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /transactions/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /workAssignments/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /employees/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /machinery/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /nutritionPlans/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /planExecutions/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /dailyLogs/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /employeeGroups/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /forumPosts/{id} {
      allow read, write: if isAuthenticated(); // Posts can be made by anyone authenticated for now? Or verified? Let's use isVerified for writes.
      allow write: if isVerified();
      allow get: if isAuthenticated();
    }

    match /listings/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.get('sellerId', '') == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.get('sellerId', '') == request.auth.uid &&
        request.resource.data.get('sellerId', '') == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.get('sellerId', '') == request.auth.uid);
    }

    match /bids/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.get('bidderId', '') == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.get('bidderId', '') == request.auth.uid &&
        request.resource.data.get('bidderId', '') == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.get('bidderId', '') == request.auth.uid);
    }

    match /reviews/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.get('authorId', '') == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.get('authorId', '') == request.auth.uid &&
        request.resource.data.get('authorId', '') == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.get('authorId', '') == request.auth.uid);
    }

    match /alerts/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /harvestEntries/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /pallets/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /harvestLogs/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /inventoryTransactions/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /suppliers/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /purchaseOrders/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /notes/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /checkpoints/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /crops/{id} {
      allow read, delete: if isVerified() && isMemberOf(resource.data.get('organizationId', ''));
      allow create: if isVerified() && isMemberOf(request.resource.data.get('organizationId', ''));
      allow update: if isVerified() && isMemberOf(resource.data.get('organizationId', '')) &&
        isMemberOf(request.resource.data.get('organizationId', ''));
    }

    match /subscriptionRequests/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isOrgAdmin(request.resource.data.organizationId) &&
        request.resource.data.keys().hasOnly(['id','userId','organizationId','planId','status','requestedCurrency','requestedAt']) &&
        request.resource.data.id == id && request.resource.data.userId == request.auth.uid &&
        id == request.auth.uid + '_' + request.resource.data.organizationId + '_' + request.resource.data.planId &&
        request.resource.data.planId in ['trial','starter','pro','enterprise'] &&
        request.resource.data.get('requestedCurrency', 'USD') in ['USD','GEL'] &&
        request.resource.data.status == 'pending' && request.resource.data.requestedAt is string;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt','reason']) &&
        request.resource.data.reviewedBy == request.auth.uid && request.resource.data.status in ['approved','rejected'];
      allow delete: if isAdmin();
    }
    // Explicit, private snapshots. Local operational writes never use these paths.
    match /localBackups/{uid}/snapshots/{backupId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['id','farmId','farmName','createdAt','status','chunks','sha256','format','version']) &&
        request.resource.data.id == backupId && request.resource.data.format == 'agrimap-farm-data' && request.resource.data.version == 2 &&
        request.resource.data.status in ['uploading','complete'] && request.resource.data.chunks is int && request.resource.data.chunks > 0 && request.resource.data.chunks <= 10000 && request.resource.data.sha256 is string;
      match /chunks/{chunkId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['index','data']) && request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.data is string && request.resource.data.data.size() <= 600000;
      }
    }

    match /platformAccess/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if false;
    }
    match /platformAudit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /billingAudit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /systemLogs/{id} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isAuthenticated() && resource.data.organizationId != null && isMemberOf(resource.data.organizationId));
      allow write: if isAuthenticated();
    }

    match /unique_identifiers/{id} {
      allow get: if true;
      allow create: if isAuthenticated();
    }
    match /cropVarieties/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

  }
}
